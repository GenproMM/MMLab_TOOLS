<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Управление разделами и проектами"
    Width="700"
    Height="500"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="ListHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style x:Key="ListItem" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   Text="Управление разделами и проектами"
                   FontSize="16" FontWeight="Bold" Foreground="#333333"
                   Margin="0,0,0,16"/>

        <!-- Столбец: Разделы -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="Разделы" Style="{StaticResource ListHeader}"/>
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SectionsPanel" Margin="6,4"/>
                </ScrollViewer>
            </Border>
            <Button x:Name="BtnAddSection" Content="+ Добавить раздел" Style="{StaticResource AddButton}"/>
        </StackPanel>

        <!-- Столбец: Проекты -->
        <StackPanel Grid.Row="1" Grid.Column="2">
            <TextBlock Text="Проекты" Style="{StaticResource ListHeader}"/>
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProjectsPanel" Margin="6,4"/>
                </ScrollViewer>
            </Border>
            <Button x:Name="BtnAddProject" Content="+ Добавить проект" Style="{StaticResource AddButton}"/>
        </StackPanel>

        <!-- Кнопки: Импорт, Закрыть -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnImportConfig"
                    Content="Импорт конфигурации"
                    Width="160" Height="32"
                    Margin="0,0,8,0"
                    ToolTip="Загрузить конфигурацию из JSON файла"/>
            <Button x:Name="BtnClose" Content="Закрыть" Width="100" Height="32"/>
        </StackPanel>
    </Grid>
</Window>
