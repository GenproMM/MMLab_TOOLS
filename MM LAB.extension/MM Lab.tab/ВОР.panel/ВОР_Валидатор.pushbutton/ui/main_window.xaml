<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Валидатор параметров ВОР"
    Width="520"
    Height="620"
    MinWidth="450"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="#F5F5F5">

    <Window.Resources>
        <!-- Стиль кнопок -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль вторичных кнопок -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль ComboBox -->
        <Style x:Key="StyledComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Раздел / Проект -->
            <RowDefinition Height="Auto"/>
            <!-- Заголовок скриптов + кнопка добавить -->
            <RowDefinition Height="*"/>
            <!-- Список скриптов -->
            <RowDefinition Height="Auto"/>
            <!-- Описание скрипта -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка запуска -->
        </Grid.RowDefinitions>

        <!-- ====== ЗАГОЛОВОК ====== -->
        <TextBlock Grid.Row="0"
                   Text="Валидатор параметров ВОР"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#333333"
                   Margin="0,0,0,12"/>

        <!-- ====== РАЗДЕЛ / ПРОЕКТ ====== -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Label Content="Раздел" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Padding="0,4"/>
                <ComboBox x:Name="CmbSection"
                          Style="{StaticResource StyledComboBox}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Label Content="Проект" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Padding="0,4"/>
                <ComboBox x:Name="CmbProject"
                          Style="{StaticResource StyledComboBox}"/>
            </StackPanel>

            <Button x:Name="BtnSettings"
                    Grid.Column="4"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SecondaryButton}"
                    ToolTip="Управление разделами и проектами"
                    Padding="0"
                    FontSize="16">
                ⚙
            </Button>
        </Grid>

        <!-- ====== ЗАГОЛОВОК СКРИПТОВ + КНОПКИ ====== -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Скрипты проверки"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       VerticalAlignment="Center"/>

            <Button x:Name="BtnLastReport"
                    Grid.Column="1"
                    Content="📋 Последний отчёт"
                    Style="{StaticResource SecondaryButton}"
                    ToolTip="Открыть результаты последнего прогона"/>

            <Button x:Name="BtnAddCheck"
                    Grid.Column="3"
                    Content="Добавить скрипт +"
                    Style="{StaticResource SecondaryButton}"/>
        </Grid>

        <!-- ====== СПИСОК СКРИПТОВ ====== -->
        <Border Grid.Row="3"
                BorderBrush="#CCCCCC"
                BorderThickness="1">
            <ScrollViewer x:Name="ScriptsScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ScriptsPanel" Margin="6,4">
                    <!-- Скрипты добавляются динамически -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ====== ОПИСАНИЕ СКРИПТА ====== -->
        <Border x:Name="DescriptionBorder"
                Grid.Row="4"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Background="#FAFAFA"
                Padding="8,6"
                Margin="0,4,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="TxtDescription"
                       Text=""
                       FontSize="12"
                       Foreground="#666666"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ====== КНОПКА ЗАПУСКА ====== -->
        <Button x:Name="BtnRunValidation"
                Grid.Row="5"
                Content="Запустить проверку"
                Style="{StaticResource PrimaryButton}"
                Height="42"
                FontSize="14"
                FontWeight="SemiBold"
                Margin="0,12,0,0"/>
    </Grid>
</Window>
