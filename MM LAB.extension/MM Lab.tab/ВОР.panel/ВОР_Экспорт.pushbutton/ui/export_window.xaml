<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Экспорт спецификаций ВОР"
    Width="550"
    Height="600"
    MinWidth="450"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StyledComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Раздел / Проект -->
            <RowDefinition Height="Auto"/>
            <!-- Путь выгрузки -->
            <RowDefinition Height="Auto"/>
            <!-- Заголовок источников + кнопка добавить -->
            <RowDefinition Height="*"/>
            <!-- Список источников -->
            <RowDefinition Height="Auto"/>
            <!-- Предупреждение -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка экспорта -->
        </Grid.RowDefinitions>

        <!-- ====== ЗАГОЛОВОК ====== -->
        <TextBlock Grid.Row="0"
                   Text="Экспорт спецификаций ВОР"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#333333"
                   Margin="0,0,0,12"/>

        <!-- ====== РАЗДЕЛ / ПРОЕКТ ====== -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Label Content="Раздел" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Padding="0,4"/>
                <ComboBox x:Name="CmbSection"
                          Style="{StaticResource StyledComboBox}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Label Content="Проект" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Padding="0,4"/>
                <ComboBox x:Name="CmbProject"
                          Style="{StaticResource StyledComboBox}"/>
            </StackPanel>

            <Button x:Name="BtnSettings"
                    Grid.Column="4"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SecondaryButton}"
                    ToolTip="Управление разделами и проектами"
                    Padding="0"
                    FontSize="16">
                &#x2699;
            </Button>
        </Grid>

        <!-- ====== ПУТЬ ВЫГРУЗКИ ====== -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Путь выгрузки"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     x:Name="TxtOutputPath"
                     Height="30"
                     FontSize="13"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="3"
                    x:Name="BtnBrowseOutput"
                    Content="..."
                    Style="{StaticResource SecondaryButton}"
                    Width="36"
                    Height="30"/>
        </Grid>

        <!-- ====== ЗАГОЛОВОК ИСТОЧНИКОВ + ДОБАВИТЬ ====== -->
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <TextBlock Text="Источники данных"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnAddSource"
                    Content="Добавить +"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"/>
        </Grid>

        <!-- ====== СПИСОК ИСТОЧНИКОВ ====== -->
        <Border Grid.Row="4"
                BorderBrush="#CCCCCC"
                BorderThickness="1">
            <ScrollViewer x:Name="SourcesScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SourcesPanel" Margin="6,4">
                    <!-- Источники добавляются динамически -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ====== ПРЕДУПРЕЖДЕНИЕ ====== -->
        <Border x:Name="WarningBorder"
                Grid.Row="5"
                BorderBrush="#FF9800"
                BorderThickness="1"
                Background="#FFF8E1"
                Padding="8,6"
                Margin="0,4,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="TxtWarning"
                       FontSize="12"
                       Foreground="#E65100"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ====== КНОПКА ЭКСПОРТА ====== -->
        <Button x:Name="BtnExport"
                Grid.Row="6"
                Content="Экспортировать"
                Style="{StaticResource PrimaryButton}"
                Height="42"
                FontSize="14"
                FontWeight="SemiBold"
                Margin="0,12,0,0"/>
    </Grid>
</Window>
